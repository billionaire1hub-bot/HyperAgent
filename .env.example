# Required
DATABASE_URL=
GEMINI_API_KEY=
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
SESSION_SECRET=            # >= 32 chars
A2A_OWNER_PASSWORD=
# Strongly recommended
PUBLIC_BASE_URL=           # e.g. https://yourapp.up.railway.app (or enable a Railway public domain)
NODE_ENV=production
WHOP_PRODUCT_ID=           # set if checkout creation fails
# Optional (defaults shown)
A2A_OWNER_USERNAME=owner
A2A_INBOUND_REQUIRE_TOKEN=false
A2A_INBOUND_TOKEN=
AUTO_OUTREACH=true
HUNTER_INTERVAL_MS=1800000
OUTREACH_MAX_PER_CYCLE=3
OUTREACH_COOLDOWN_DAYS=7
GEMINI_MODEL=gemini-2.5-flash
PRICING_MIN_CENTS=100
PRICING_MAX_CENTS=0
PRICING_MULTIPLIER=1
PRICING_FLOOR_RATIO=0.6
PRICING_USE_GEMINI=true
